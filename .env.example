# ──────────────────────────────────────────────
# Ghayoomi Examer — الگوی تنظیمات محیطی
# این فایل فقط نمونه است؛ اطلاعات واقعی را در آن وارد نکنید.
# برای تنظیم محلی، یک کپی با نام .env بسازید.
# در GitHub Actions، مقادیر حساس را در Secrets نگهداری کنید.
# ──────────────────────────────────────────────

# توکن ربات، دریافت‌شده از @BotFather — الزامی
BOT_TOKEN=YOUR_BOT_TOKEN

# شناسهٔ عددی حساب تلگرام مالک ربات — الزامی
# سایر مدیران از پنل مدیریت اضافه می‌شوند.
OWNER_ID=YOUR_TELEGRAM_USER_ID

# شناسهٔ عددی مدیران اولیه — اختیاری؛ شناسه‌ها را با کاما جدا کنید.
ADMIN_IDS=

# مسیر فایل دیتابیس — نمونهٔ قابل تغییر
DB_PATH=data/ghayoomi.db

# نام کاربری ورود به پنل مدیریت — یک مقدار اختصاصی انتخاب کنید.
# تنظیم این مقدار در GitHub Secrets برای اجرای خودکار الزامی است.
ADMIN_LOGIN=CHOOSE_A_PRIVATE_LOGIN

# رمز عبور پنل مدیریت — رمز قوی و منحصربه‌فرد انتخاب کنید.
# این رمز را در مخزن، مستندات یا تصاویر منتشر نکنید.
ADMIN_PASSWORD=CHOOSE_A_STRONG_PASSWORD
