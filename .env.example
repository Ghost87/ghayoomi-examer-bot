# ──────────────────────────────────────────────
# 🎓 Ghayoomi Examer Bot — نمونه تنظیمات محیطی
# این فایل را به اسم .env کپی کنید و مقادیر را پر کنید
# ──────────────────────────────────────────────

# توکن ربات از @BotFather  (الزامی)
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# آیدی عددی صاحب ربات (الزامی) — بقیه ادمین‌ها از پنل اضافه می‌شوند
OWNER_ID=123456789

# آیدی عددی ادمین‌های اولیه (اختیاری، با کاما جدا کنید)
ADMIN_IDS=

# مسیر دیتابیس (اختیاری)
DB_PATH=data/ghayoomi.db

# ورود مخفی پنل ادمین (اختیاری — پیش‌فرض همین‌هاست)
ADMIN_LOGIN=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
