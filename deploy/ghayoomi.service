[Unit]
Description=Ghayoomi Examer Telegram Bot 🎓
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ghayoomi_examer_bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/ghayoomi_examer_bot/.venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
